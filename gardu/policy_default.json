{
  "description": "Default Gardu call-gate policy. Copy it and edit the lists for your agent.",
  "tools": {
    "allow": ["read_*", "list_*", "search_*", "get_*", "fetch"],
    "ask": ["write_*", "edit_*", "create_*", "run_*", "exec*", "shell*", "send_*", "post_*", "delete_*", "move_*"],
    "deny": [],
    "default": "ask"
  },
  "paths": {
    "deny": ["~/.ssh/*", "~/.ssh/**", "~/.aws/*", "~/.gnupg/*", "~/.kube/*", "*/.env", "*.pem", "*id_rsa*", "*id_ed25519*", "*/.git-credentials", "*/.netrc"],
    "allow_roots": []
  },
  "network": {
    "mode": "open",
    "allow_hosts": [],
    "deny_hosts": []
  },
  "outputs": {
    "quarantine_at": "high"
  }
}
